# ---------------------------------------------------------------------------
# FRONTEND (Vite) — exposed to the browser bundle. NEVER put real secrets here.
# On Vercel these are set under Project Settings > Environment Variables.
# The Vercel<>Supabase integration injects SUPABASE_URL / SUPABASE_ANON_KEY;
# vite.config.ts bridges those to the VITE_* names below, so you normally only
# need to set them here for local `npm run dev`.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-SUPABASE-ANON-KEY"
# Optional: derived from VITE_SUPABASE_URL automatically if omitted.
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Temporary dev auth bypass -------------------------------------------------
# "true" skips the login screen and drops straight into the dashboard.
# Set to "false" (or remove) to bring real Supabase Auth back.
VITE_DEV_BYPASS_AUTH="false"
# Optional: when bypass is on AND these are set, the app auto signs in with a
# real Supabase user (so RLS + edge functions work with a valid JWT). Leave
# blank to use a fake client-only session instead (UI renders, data may be empty).
VITE_DEV_LOGIN_EMAIL=""
VITE_DEV_LOGIN_PASSWORD=""
# UUID used for the fake session when no dev login is configured.
VITE_DEV_USER_ID="1b0affc0-d2e9-4f5c-87fc-3776e04bc3e9"

# ---------------------------------------------------------------------------
# BACKEND — set these in Supabase, NOT here:
#   Supabase Dashboard > Project Settings > Edge Functions > Secrets
#   (or: supabase secrets set KEY=value)
#
#   SUPABASE_URL                    (auto)
#   SUPABASE_ANON_KEY               (auto)
#   SUPABASE_SERVICE_ROLE_KEY      (auto)
#   GOOGLE_CLIENT_ID               OAuth client id  (MCC set 1)
#   GOOGLE_CLIENT_SECRET          OAuth client secret (MCC set 1)
#   GOOGLE_ADS_DEVELOPER_TOKEN     Google Ads developer token (MCC set 1)
#   GAM_SERVICE_ACCOUNT_JSON       full service-account JSON with Ad Manager access
#   GUEST_LOGIN_EMAIL / GUEST_LOGIN_PASSWORD / GUEST_OWNER_USER_ID  (optional)
#
#   Second MCC later: add GOOGLE_CLIENT_ID_2 / GOOGLE_CLIENT_SECRET_2 /
#   GOOGLE_ADS_DEVELOPER_TOKEN_2 — no code change needed.
#
# Postgres setting used by cron jobs (run once in the SQL editor):
#   ALTER DATABASE postgres SET app.settings.service_role_key = '<service-role-key>';
# ---------------------------------------------------------------------------
