import { createClient } from "https://esm.sh/@supabase/supabase-js@2.45.0";
import { corsHeaders } from "../_shared/cors.ts";

const GAM_BASE = "https://admanager.googleapis.com/v1";
const SCOPE = "https://www.googleapis.com/auth/admanager";

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
  
  const debug: string[] = [];
  try {
    const authHeader = req.headers.get("Authorization");
    if (!authHeader) return json({ error: "No auth header" });

    let body: any = {};
    try { body = await req.json(); } catch { /* */ }

    const datePreset = body.date_preset || "today";
    const requestedSiteId = body.site_id || null;
    const requestedUserId = body.user_id || null;
    const requestedAccountIds = body.account_ids || [];
    const revenueOnly = body.revenue_only || false;
    const skipViewability = body.skip_viewability || false;
    const skipSnapshotRegen = body.skip_snapshot_regen || false;
    const skipLegacyReports = body.skip_legacy_reports || revenueOnly;
    const siteMetricsOnly = body.site_metrics_only || false;
    const testMode = body.test || false;

    const saJsonRaw = Deno.env.get("GAM_SERVICE_ACCOUNT_JSON");
    if (!saJsonRaw) return json({ error: "GAM_SERVICE_ACCOUNT_JSON não configurada" });
    const sa = JSON.parse(saJsonRaw);

    const userClient = createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_ANON_KEY")!);
    const token = authHeader.replace("Bearer ", "");
    const serviceRoleKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
    
    let userId: string | undefined;
    if (token === serviceRoleKey.trim()) {
      userId = requestedUserId;
    } else {
      const { data: { user } } = await userClient.auth.getUser(token);
      userId = user?.id;
    }
    if (!userId) return json({ error: "Unauthorized" });

    const admin = createClient(Deno.env.get("SUPABASE_URL")!, serviceRoleKey);
    
    let sitesQuery = admin.from("sites").select("*").eq("user_id", userId);
    if (requestedSiteId) sitesQuery = sitesQuery.eq("id", requestedSiteId);
    const { data: sites } = await sitesQuery;
    if (!sites || sites.length === 0) return json({ error: "No sites" });

    const accessToken = await getAccessToken(sa);
    const fxRates = await getFxRates(debug);
    const usdToBrlRate = fxRates.usdBrl || 5.15;

    const summary: any[] = [];
    const deadlineAt = Date.now() + 140_000;

    for (const site of sites) {
      const networkCode = site.network_code;
      const ranges = buildGamRanges(datePreset);
      const todayStr = new Date().toISOString().slice(0, 10);
      
      // 1. Puxar Receita Total do Site (Viewability Report) - Liberado rápido pelo Google
      let viewabilityRows: any[] = [];
      const vVariants = [
        { label: "AD_SERVER", metrics: ["AD_SERVER_IMPRESSIONS", "AD_SERVER_REVENUE"] },
        { label: "AD_EXCHANGE", metrics: ["AD_EXCHANGE_IMPRESSIONS", "AD_EXCHANGE_REVENUE"] }
      ];
      const aggMap = new Map();
      for (const v of vVariants) {
        try {
          const rows = (await Promise.all(ranges.map(r => runReport({ networkCode, accessToken, range: r, dimensions: ["DATE"], metrics: v.metrics, debug, deadlineAt })))).flat();
          for (const r of rows) {
            const d = r.date || "_";
            const cur = aggMap.get(d) ?? { impr: 0, rev: 0 };
            cur.impr += r.impressions; cur.rev += r.revenue;
            aggMap.set(d, cur);
          }
        } catch (e) { debug.push(`Viewability ${v.label} failed: ${e.message}`); }
      }
      viewabilityRows = [...aggMap.entries()].map(([d, v]) => ({ date: d === "_" ? null : d, impressions: v.impr, revenue: v.rev }));

      // 2. Puxar Atribuição segmentada (REST v1 Consolidated)
      let attribution = await collectUtmAttribution({ networkCode, accessToken, ranges, debug, deadlineAt });

      // 3. Puxar Atribuição segmentada (SOAP Intraday Fallback - URL_NAME)
      // (Ignorado se SOAP estiver quebrado, como reportado)

      // 4. SENIOR FALLBACK: Predictive Intraday
      // Se não temos dados segmentados para hoje, mas temos o total do site, estimamos.
      const siteToday = viewabilityRows.find(r => r.date === todayStr);
      const hasRealData = attribution.googleCampaignRows.some(r => r.date === todayStr && r.revenue > 0);
      
      if (!hasRealData && siteToday && siteToday.revenue > 0) {
        debug.push(`Predictive Fallback: SiteRev=${siteToday.revenue} SiteImpr=${siteToday.impressions}`);
        const predictive = await collectPredictiveIntradayAttribution({
          networkCode, accessToken, ranges, totalSiteRevenue: siteToday.revenue, totalSiteImpressions: siteToday.impressions, debug, deadlineAt
        });
        attribution.googleCampaignRows.push(...predictive.googleCampaignRows);
      }

      // 5. Persistência
      const ingestionDivisor = site.gam_currency === "BRL" ? usdToBrlRate : 1;
      await persistCampaignSourceRevenueFromUtm(admin, userId, site.id, [...attribution.retentionRows, ...attribution.googleCampaignRows], debug, [], ingestionDivisor);
      
      summary.push({ site: site.name, google_rows: attribution.googleCampaignRows.length, total_rev: siteToday?.revenue || 0 });
    }

    return json({ ok: true, summary, debug });
  } catch (e) {
    return json({ error: e.message, debug });
  }
});

async function runReport(args: any): Promise<any[]> {
  const { networkCode, accessToken, range, dimensions, metrics, debug } = args;
  const res = await fetch(`${GAM_BASE}/networks/${networkCode}/reports:run`, {
    method: "POST",
    headers: { Authorization: `Bearer ${accessToken}`, "Content-Type": "application/json" },
    body: JSON.stringify({
      reportDefinition: { reportType: "HISTORICAL", dimensions, metrics, dateRange: range.dateRange }
    })
  });
  const j = await res.json();
  if (!res.ok) throw new Error(JSON.stringify(j));
  
  // Polling for completion... (simplified for this view)
  return []; 
}

// ... existing helper functions (getAccessToken, fxRates, etc)
function json(p: any) { return new Response(JSON.stringify(p), { headers: { ...corsHeaders, "Content-Type": "application/json" } }); }
